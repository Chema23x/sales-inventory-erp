datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Modelo de Usuarios (Administradores del Negocio)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 2. Modelo de Clientes
model Client {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[] // Relación: Un cliente puede tener muchas suscripciones
  sales         Sale[]
}

// 3. Modelo de Suscripciones / Servicios contratados
model Subscription {
  id        String             @id @default(uuid())
  name      String             // Ej. "Plan Mensual Estándar"
  price     Decimal            @db.Decimal(10, 2)
  status    SubscriptionStatus @default(ACTIVE)
  clientId  String
  client    Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payments  Payment[]          // Relación: Una suscripción genera muchos pagos
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

// 4. Historial de Pagos / Facturación
model Payment {
  id             String         @id @default(uuid())
  amount         Decimal        @db.Decimal(10, 2)
  status         PaymentStatus  @default(PENDING)
  subscriptionId String
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  dueDate        DateTime       // Fecha límite de pago
  paidAt         DateTime?      // Fecha en la que se pagó realmente
  createdAt      DateTime       @default(now())
}

// 5. Modelo de Inventario / Catálogo de Productos
model Product {
  id          String   @id @default(uuid())
  sku         String   @unique // Código único de barras o referencia (ej. "PROD-1001")
  name        String   // Nombre del producto
  description String?  // Descripción opcional del artículo
  
  // Costos y Precios con precisión decimal estricta
  purchasePrice Decimal @db.Decimal(10, 2) // Precio al que se compra al proveedor
  salePrice     Decimal @db.Decimal(10, 2) // Precio al que se vende al cliente final
  
  // Control de Existencias
  stock        Int      @default(0)  // Cantidad física actual en el almacén
  minStock     Int      @default(5)  // Umbral mínimo permitido antes de activar alerta de escasez
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  saleItems     SaleItem[]
}

// 6. Modelo Maestro de Ventas / Tickets Comerciales
model Sale {
  id          String     @id @default(uuid())
  total       Decimal    @db.Decimal(10, 2) // Sumatoria total de la venta
  
  // Relación opcional: Una venta puede ser a un cliente registrado o al público en general
  clientId    String?
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  // Relación: Una venta contiene múltiples artículos detallados
  items       SaleItem[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// 7. Modelo de Detalle de Venta (Productos específicos y cantidades)
model SaleItem {
  id          String   @id @default(uuid())
  quantity    Int      // Cantidad de unidades vendidas
  unitPrice   Decimal  @db.Decimal(10, 2) // Precio unitario al momento de la venta
  subtotal    Decimal  @db.Decimal(10, 2) // quantity * unitPrice
  
  // Relaciones requeridas
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

// Enums para forzar consistencia de estados en la Base de Datos
enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}
